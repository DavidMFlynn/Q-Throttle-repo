DEF IR2102 U 0 40 Y Y 1 F N
F0 "U" 0 250 50 H V C CNN
F1 "IR2102" 0 -350 50 H V C CNN
F2 "" 0 250 60 H V C CNN
F3 "" 0 250 60 H V C CNN
DRAW
S -250 200 250 -300 0 1 10 f
X VCC 1 -400 100 150 R 50 50 1 1 W
X HIN 2 -400 0 150 R 50 50 1 1 I
X LIN 3 -400 -100 150 R 50 50 1 1 I
X COM 4 -400 -200 150 R 50 50 1 1 w
X LO 5 400 -200 150 L 50 50 1 1 w
X Vs 6 400 -100 150 L 50 50 1 1 W
X HO 7 400 0 150 L 50 50 1 1 w
X VB 8 400 100 150 L 50 50 1 1 w
ENDDRAW
ENDDEF
